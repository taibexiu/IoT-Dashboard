HOST=127.0.0.1
PORT=5000
FRONTEND_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
# sql: dữ liệu thật trong SQL Server. demo: chạy thử, không lưu database.
DATA_MODE=sql
DB_SERVER=localhost
DB_PORT=1433
DB_NAME=IoTDashboard
DB_USER=sa
DB_PASSWORD=your-sql-server-password
DB_ENCRYPT=false
DB_TRUST_CERTIFICATE=true
# Nếu dùng SQLEXPRESS: đặt DB_INSTANCE=SQLEXPRESS (bỏ trống để dùng DB_PORT).
DB_INSTANCE=
# Khóa cho thiết bị/giả lập gửi dữ liệu cảm biến, không đặt khóa này trong FE.
DEVICE_API_KEY=replace-with-a-random-device-key-at-least-24-characters

MQTT_URL=mqtt://localhost:1111
MQTT_USER=letantai
MQTT_PASSWORD=your-mqtt-password
MQTT_TIMEOUT_MS=8000
